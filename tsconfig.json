{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Benchmark fixtures are *data* — a synthetic repo the agent reads at
  // runtime. They deliberately import packages that are not installed, and
  // one of them contains a deliberate bug. Typechecking them is meaningless.
  "exclude": ["src/bench/fixtures"]
}
